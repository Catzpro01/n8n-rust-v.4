{
  "version": "1.1.0",
  "project": "n8n-rust-v.4",
  "repository": "https://github.com/Catzpro01/n8n-rust-v.4",
  "authority_doc": "docs/architecture/n8n-rust-project-decomposition.md",
  "architecture": "10-Manager Single Entity Swarm with External Critic",
  "external_critic": {
    "provider": "ChatGPT",
    "role": "External Architectural Reviewer & Critic",
    "status": "ACTIVE"
  },
  "lock_policy": {
    "rule": "Strict Domain Isolation. Each Manager must only edit files within their designated module path to prevent git merge conflicts.",
    "branch_convention": "feature/manager-[ID]-[domain-slice]"
  },
  "managers": {
    "M01": {
      "name": "Manager-01",
      "milestone": "M1",
      "domain": "Runtime Kernel",
      "specialization": "runtime-kernel",
      "paths": ["crates/n8n-workflow/src/runtime/**"],
      "status": "ACTIVE",
      "active_slice": "runtime-kernel/m1-01-execution-frame"
    },
    "M02": {
      "name": "Manager-02",
      "milestone": "M5",
      "domain": "Node System",
      "specialization": "node-system",
      "paths": ["crates/n8n-nodes-rust/**", "crates/n8n-node-model/**"],
      "status": "ACTIVE",
      "active_slice": "node-system/m5-01-node-traits"
    },
    "M03": {
      "name": "Manager-03",
      "milestone": "M7",
      "domain": "Expression Engine",
      "specialization": "expression-engine",
      "paths": ["crates/n8n-expression/**"],
      "status": "ACTIVE",
      "active_slice": "expression-engine/m7-01-ast-tokenizer"
    },
    "M04": {
      "name": "Manager-04",
      "milestone": "M2",
      "domain": "Execution Engine & Scheduler",
      "specialization": "execution-engine",
      "paths": ["crates/n8n-workflow/src/runtime/executor.rs", "crates/n8n-connection/**"],
      "status": "ACTIVE",
      "active_slice": "execution-engine/m2-01-state-machine"
    },
    "M05": {
      "name": "Manager-05",
      "milestone": "M4",
      "domain": "Memory Management & Triggers",
      "specialization": "memory",
      "paths": ["crates/n8n-workflow/src/runtime/memory.rs", "crates/triggers/**"],
      "status": "ACTIVE",
      "active_slice": "memory/m4-01-heap-governor"
    },
    "M06": {
      "name": "Manager-06",
      "milestone": "M3",
      "domain": "Data Plane",
      "specialization": "data-plane",
      "paths": ["crates/n8n-execution-data/**"],
      "status": "ACTIVE",
      "active_slice": "data-plane/m3-01-item-buffer"
    },
    "M07": {
      "name": "Manager-07",
      "milestone": "M10",
      "domain": "Security & Sandbox Conformance",
      "specialization": "security",
      "paths": ["tools/arena-executor/fs_guard.py", "apps/n8n-lego/test/**"],
      "status": "ACTIVE",
      "active_slice": "security/m10-01-fs-sandbox"
    },
    "M08": {
      "name": "Manager-08",
      "milestone": "M8",
      "domain": "Validation",
      "specialization": "validation",
      "paths": ["crates/n8n-validation/**"],
      "status": "ACTIVE",
      "active_slice": "validation/m8-01-cycle-detection"
    },
    "M09": {
      "name": "Manager-09",
      "milestone": "M9",
      "domain": "Integration & Conformance",
      "specialization": "integration",
      "paths": ["tests/**", "crates/n8n-common/**"],
      "status": "ACTIVE",
      "active_slice": "integration/m9-01-conformance-harness"
    },
    "M10": {
      "name": "Manager-10",
      "milestone": "M6",
      "domain": "Workflow Model & Swarm Arbiter",
      "specialization": "workflow-model",
      "paths": ["crates/n8n-workflow/src/lib.rs", "crates/n8n-workflow/src/connections.rs", "kanban/**"],
      "status": "ACTIVE_COORDINATING",
      "active_slice": "workflow-model/m6-01-schema-deserializer"
    }
  }
}
