# ---------------------------------------------------------------------------
# TYPE SCRIPT RUNTIME (apps/n8n-ts) — contract: contracts/runtime-api.contract.md §2
# Every variable below is optional; the defaults shown are what the runtime uses.
# Invalid values abort the boot with exit code 78 and a message naming the variable.
# ---------------------------------------------------------------------------

# --- binding ---------------------------------------------------------------
# N8N_TS_HOST=0.0.0.0            # also accepts HOST
# N8N_TS_PORT=5678               # also accepts PORT
# N8N_TS_ENV=production         # development | production | test

# --- logging ---------------------------------------------------------------
# N8N_TS_LOG_LEVEL=info          # debug | info | warn | error
# N8N_TS_LOG_FORMAT=json         # json (systemd/journald) | text (laptop)

# --- storage ---------------------------------------------------------------
# N8N_TS_DATA_DIR=./data         # workflows.json + executions/**
# N8N_TS_STORAGE=file            # file | memory (memory = nothing persisted)
# N8N_TS_EXECUTION_HISTORY=200   # records kept, newest first
# N8N_TS_PID_FILE=./data/runtime.pid

# --- execution -------------------------------------------------------------
# N8N_TS_EXECUTION_TIMEOUT_MS=30000
# N8N_TS_MAX_BODY_BYTES=1048576
# N8N_TS_UNKNOWN_NODE_POLICY=passthrough      # passthrough | error
# N8N_TS_UNKNOWN_CONNECTION_POLICY=warn       # warn | error
# N8N_TS_ALLOW_CODE_EVAL=false                # true runs jsCode in-process (NOT production safe)
# N8N_TS_LOCALE=id                            # id | jv | ar | zh | ru | en

# --- HTTP security ---------------------------------------------------------
# Leave N8N_TS_API_KEY unset for local development (the console works without a
# key and the runtime logs/doctor.sh warn about it). On a VPS, generate one and
# uncomment: every /api/v1 request must then send "X-N8N-API-KEY: <value>";
# /healthz and the console stay open either way.
#   N8N_TS_API_KEY=$(openssl rand -hex 24)
# N8N_TS_API_KEY=
# N8N_TS_CORS_ORIGIN=*           # an explicit origin, or off to disable CORS headers
