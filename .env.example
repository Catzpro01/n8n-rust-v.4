# =============================================================================
# n8n-rust-v.4 environment example
# Copy to .env and edit. Never commit real secrets.
# =============================================================================

# --- Arena control plane (optional; not required for n8n-ts baseline) ---------
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_publishable_anon_key_here
SUPABASE_SECRET_KEY=your_service_role_secret_key_here
SUPABASE_JWKS_URL=https://your-project-id.supabase.co/auth/v1/.well-known/jwks.json

GITHUB_WEBHOOK_SECRET=your_github_webhook_secret_here
GITHUB_APP_ID=your_github_app_id_here
GITHUB_APP_PRIVATE_KEY_PATH=/etc/arena/github_app.pem

# --- n8n-ts TypeScript baseline runtime --------------------------------------
# Contract: contracts/ts-runtime-baseline.contract.md
NODE_ENV=production
N8N_TS_HOST=0.0.0.0
N8N_TS_PORT=5678
# Optional URL prefix (no trailing slash), e.g. /n8n
N8N_TS_BASE_PATH=
N8N_LOCALE=id
N8N_TS_LOG_LEVEL=info
# Max JSON body bytes for POST /api/v1/workflows/run (default 1 MiB)
N8N_TS_PAYLOAD_LIMIT=1048576
N8N_TS_PID_FILE=run/n8n-ts.pid
N8N_TS_LOG_FILE=run/n8n-ts.log
