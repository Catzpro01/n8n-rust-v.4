[Unit]
Description=Arena Executor - Jailed Workspace Task Runner
After=network.target

[Service]
Type=simple
User=fern
Group=fern
WorkingDirectory=/srv/arena
ExecStart=/usr/bin/python3 -m tools.arena-executor.cli
Restart=always
RestartSec=5
EnvironmentFile=-/home/fern/arena/.env
Environment=PYTHONUNBUFFERED=1
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/srv/arena/workspaces /srv/arena/logs /srv/arena/cache /srv/arena/runtime
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
