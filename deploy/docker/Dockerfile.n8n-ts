# n8n-ts baseline — production-ish image (Node 22)
# Build from repo root:
#   docker build -f deploy/docker/Dockerfile.n8n-ts -t n8n-ts-baseline .
FROM node:22-bookworm-slim

WORKDIR /app

# OS basics for healthcheck
RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates \
  && rm -rf /var/lib/apt/lists/*

# Copy only what the TS baseline needs (no Rust toolchain)
COPY package.json ./
COPY apps/n8n-ts ./apps/n8n-ts
COPY packages/reconstructed-engine ./packages/reconstructed-engine
COPY packages/execution-lego ./packages/execution-lego
COPY packages/workflow-lego ./packages/workflow-lego
COPY contracts/ts-runtime-baseline.contract.md ./contracts/ts-runtime-baseline.contract.md
COPY scripts ./scripts
COPY .env.example ./

RUN mkdir -p /app/run \
  && npm install --prefix apps/n8n-ts --omit=dev --no-audit --no-fund \
  && chmod +x scripts/*.sh || true

ENV NODE_ENV=production \
    N8N_TS_HOST=0.0.0.0 \
    N8N_TS_PORT=5678 \
    N8N_LOCALE=id

EXPOSE 5678

HEALTHCHECK --interval=15s --timeout=3s --start-period=5s --retries=3 \
  CMD curl -sf http://127.0.0.1:5678/healthz || exit 1

USER node
CMD ["node", "apps/n8n-ts/src/server.mjs"]
