{
  "_purpose": "Shared case list for the port-vs-engine differential (Stage 2k). Each case is executed TWICE: once by the real n8n 2.9.4 engine and once by the Rust port. Neither side's answer is written here — the harness compares them to each other, so this file can never encode a wrong expectation.",
  "_rule": "ISSUE-026: a divergence claim requires BOTH sides executed.",
  "cases": [
    { "id": "lone-omitted",      "op": "getStartNode", "dest": "A",
      "nodes": [["A", null]], "connections": {} },
    { "id": "lone-false",        "op": "getStartNode", "dest": "A",
      "nodes": [["A", false]], "connections": {} },
    { "id": "lone-true",         "op": "getStartNode", "dest": "A",
      "nodes": [["A", true]], "connections": {} },
    { "id": "parent-omitted",    "op": "getStartNode", "dest": "B",
      "nodes": [["A", null], ["B", null]],
      "connections": { "A": { "main": [[{ "node": "B", "type": "main", "index": 0 }]] } } },
    { "id": "parent-false",      "op": "getStartNode", "dest": "B",
      "nodes": [["A", false], ["B", null]],
      "connections": { "A": { "main": [[{ "node": "B", "type": "main", "index": 0 }]] } } },
    { "id": "parent-true",       "op": "getStartNode", "dest": "B",
      "nodes": [["A", true], ["B", null]],
      "connections": { "A": { "main": [[{ "node": "B", "type": "main", "index": 0 }]] } } },
    { "id": "mid-omitted",       "op": "getStartNode", "dest": "C",
      "nodes": [["T", null], ["M", null], ["C", null]],
      "connections": { "T": { "main": [[{ "node": "M", "type": "main", "index": 0 }]] },
                       "M": { "main": [[{ "node": "C", "type": "main", "index": 0 }]] } } },
    { "id": "mid-true",          "op": "getStartNode", "dest": "C",
      "nodes": [["T", null], ["M", true], ["C", null]],
      "connections": { "T": { "main": [[{ "node": "M", "type": "main", "index": 0 }]] },
                       "M": { "main": [[{ "node": "C", "type": "main", "index": 0 }]] } } },
    { "id": "diamond",           "op": "getStartNode", "dest": "D",
      "nodes": [["T", null], ["L", null], ["R", true], ["D", null]],
      "connections": { "T": { "main": [[{ "node": "L", "type": "main", "index": 0 },
                                        { "node": "R", "type": "main", "index": 0 }]] },
                       "L": { "main": [[{ "node": "D", "type": "main", "index": 0 }]] },
                       "R": { "main": [[{ "node": "D", "type": "main", "index": 0 }]] } } },
    { "id": "children-linear",   "op": "getChildNodes", "dest": "T",
      "nodes": [["T", null], ["M", true], ["C", null]],
      "connections": { "T": { "main": [[{ "node": "M", "type": "main", "index": 0 }]] },
                       "M": { "main": [[{ "node": "C", "type": "main", "index": 0 }]] } } },
    { "id": "parents-linear",    "op": "getParentNodes", "dest": "C",
      "nodes": [["T", null], ["M", true], ["C", null]],
      "connections": { "T": { "main": [[{ "node": "M", "type": "main", "index": 0 }]] },
                       "M": { "main": [[{ "node": "C", "type": "main", "index": 0 }]] } } },
    { "id": "cycle-children",    "op": "getChildNodes", "dest": "A",
      "nodes": [["A", null], ["B", null]],
      "connections": { "A": { "main": [[{ "node": "B", "type": "main", "index": 0 }]] },
                       "B": { "main": [[{ "node": "A", "type": "main", "index": 0 }]] } } },
    { "id": "cycle-start",       "op": "getStartNode", "dest": "B",
      "nodes": [["A", null], ["B", null]],
      "connections": { "A": { "main": [[{ "node": "B", "type": "main", "index": 0 }]] },
                       "B": { "main": [[{ "node": "A", "type": "main", "index": 0 }]] } } },
    { "id": "orphan-start",      "op": "getStartNode", "dest": "Z",
      "nodes": [["A", null], ["Z", null]],
      "connections": { "A": { "main": [[{ "node": "A", "type": "main", "index": 0 }]] } } }
  ]
