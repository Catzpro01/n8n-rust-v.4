      "position": [
        0,
        0
      ],
      "parameters": {}
    },
    {
      "id": "B",
      "name": "B",
      "type": "x",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {}
    }
  ],
  "connections": {
    "Trigger": {
      "main": [
        [
          {
            "node": "A",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "A": {
      "main": [
        [
          {
            "node": "B",
