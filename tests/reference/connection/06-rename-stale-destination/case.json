  "probes": [
    {
      "name": "after rename: source map keys",
      "op": "wf.sourceKeys"
    },
    {
      "name": "after rename: destination map keys (stale, still 'A')",
      "op": "wf.destKeys"
    },
    {
      "name": "after rename: children of Trigger (source map, fresh)",
      "op": "wf.getChildNodes",
      "node": "Trigger"
    },
    {
      "name": "after rename: parents of B (destination map, stale -> old name)",
      "op": "wf.getParentNodes",
      "node": "B"
    },
    {
      "name": "after rename: parents of A2 (stale -> [])",
      "op": "wf.getParentNodes",
      "node": "A2"
    },
    {
      "name": "after rename: parents of A (stale -> still answers)",
      "op": "wf.getParentNodes",
      "node": "A"
    },
    {
      "name": "after rename: getNodeConnectionIndexes B <- A2 (stale -> undefined)",
      "op": "wf.getNodeConnectionIndexes",
      "node": "B",
      "parent": "A2"
    },
    {
      "name": "after rename: getNodeConnectionIndexes B <- A (old name: getNode(A) is null -> undefined before the stale map is even consulted)",
      "op": "wf.getNodeConnectionIndexes",
      "node": "B",
      "parent": "A"
    },
    {
      "name": "after setConnections(same map): parents of B (rebuilt)",
      "op": "wf.rebuildThenGetParentNodes",
      "node": "B"
    }
  ]
