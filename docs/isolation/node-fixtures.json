                },
                {
                  "fieldType": "text",
                  "label": "Name"
                },
                {
                  "fieldType": "html"
                }
              ]
            }
          }
        },
        "rename": {
          "pattern": "Old Node",
          "replacement": "New Node"
        },
        "after": {
          "parameters": {
            "formFields": {
              "values": [
                {
                  "fieldType": "html",
                  "html": "Hello $('New Node').item"
                },
                {
                  "fieldType": "text",
                  "label": "Name"
                },
                {
                  "fieldType": "html"
                }
              ]
            }
          }
        },
        "returned": null
      }
    ]
  },
  "getNodeOutputs": {
    "cases": [
      {
        "name": "static-main-no-onerror",
        "node": {
          "name": "Outputs Static"
        },
        "outputs": [
          "main"
        ],
        "expect": [
          "main"
        ],
        "descriptionUnchangedAfterCall": true,
        "warned": false
      },
      {
        "name": "single-main-continue-error-output",
        "node": {
          "name": "Outputs Single Err",
          "onError": "continueErrorOutput"
        },
        "outputs": [
          "main"
        ],
        "expect": [
          {
            "type": "main",
            "displayName": "Success"
          },
          {
            "category": "error",
            "type": "main",
            "displayName": "Error"
          }
        ],
        "descriptionUnchangedAfterCall": true,
        "warned": false
      },
      {
        "name": "multi-main-continue-error-output",
        "node": {
          "name": "Outputs Multi Err",
          "onError": "continueErrorOutput"
        },
        "outputs": [
          "main",
          "main"
        ],
        "expect": [
          "main",
          "main",
          {
            "category": "error",
            "type": "main",
            "displayName": "Error"
          }
        ],
        "descriptionUnchangedAfterCall": true,
        "warned": false
      },
      {
        "name": "single-main-config-continue-error-output",
        "node": {
          "name": "Outputs Config Err",
          "onError": "continueErrorOutput"
        },
        "outputs": [
          {
            "type": "main",
            "displayName": "Out"
          }
        ],
        "expect": [
          {
            "type": "main",
            "displayName": "Success"
          },
          {
            "category": "error",
            "type": "main",
            "displayName": "Error"
          }
        ],
        "descriptionUnchangedAfterCall": true,
        "warned": false
      }
    ]
  },
