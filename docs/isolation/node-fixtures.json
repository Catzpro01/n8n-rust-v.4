        "returnDefaults": true,
        "returnNoneDisplayed": false,
        "expect": {
          "mode": "simple",
          "always": "={{ 1+1 }}"
        }
      },
      {
        "name": "return-none-displayed-keeps-hidden",
        "values": {
          "mode": "simple",
          "advOpt": "typed-but-hidden",
          "always": "={{ 1+1 }}"
        },
        "returnDefaults": true,
        "returnNoneDisplayed": true,
        "expect": {
          "mode": "simple",
          "advOpt": "typed-but-hidden",
          "always": "={{ 1+1 }}"
        }
