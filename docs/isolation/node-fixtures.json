    "comparisonRule": "deep JSON equality after per-key sort; byte-stable file by construction"
  },
  "applyAccessPatterns": {
    "cases": [
      {
        "expression": "$('Old Node').item.json.a + \"x\"",
        "previousName": "Old Node",
        "newName": "New Node",
        "expect": "$('New Node').item.json.a + \"x\""
      },
      {
        "expression": "const x = $node[\"Old Node\"].json.b",
        "previousName": "Old Node",
        "newName": "New Node",
        "expect": "const x = $node[\"New Node\"].json.b"
      },
      {
        "expression": "no reference here",
        "previousName": "Old Node",
        "newName": "New Node",
        "expect": "no reference here"
      }
    ]
  },
  "getConnectionTypes": {
