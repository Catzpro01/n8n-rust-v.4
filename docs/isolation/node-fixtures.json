            "type": "ai_tool"
          }
        ],
        "expect": [
          "main",
          "main",
          "ai_tool"
        ]
      }
    ]
  },
  "renameFormFields": {
    "cases": [
      {
        "before": {
          "parameters": {
            "formFields": {
              "values": [
                {
                  "fieldType": "html",
