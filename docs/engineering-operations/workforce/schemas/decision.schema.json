{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Catzpro01/n8n-rust-v.4/docs/engineering-operations/workforce/schemas/decision.schema.json",
  "title": "Decision",
  "description": "Durable governance choice. Historical decisions are immutable; replacement uses supersedes. Canonical promotion is a separate Manager-only command (#265 \u00a716).",
  "type": "object",
  "required": [
    "schemaVersion",
    "objectType",
    "objectId",
    "revision",
    "createdAt",
    "updatedAt",
    "state",
    "category",
    "title",
    "problem",
    "selectedOption",
    "rationale",
    "authority",
    "sources"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "objectType": {
      "const": "Decision"
    },
    "objectId": {
      "type": "string",
      "pattern": "^DEC-[0-9]{4,}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "createdAt": {
      "$ref": "#/$defs/timestamp"
    },
    "updatedAt": {
      "$ref": "#/$defs/timestamp"
    },
    "events": {
      "$ref": "#/$defs/eventRefs"
    },
    "state": {
      "enum": [
        "PROPOSED",
        "UNDER_REVIEW",
        "ACTIVE",
        "SUPERSEDED",
        "REVOKED",
        "REJECTED"
      ]
    },
    "category": {
      "enum": [
        "ARCHITECTURE",
        "OWNERSHIP",
        "VOCABULARY",
        "SECURITY",
        "MILESTONE",
        "MERGE",
        "RESOURCE",
        "RECOVERY",
        "WORKFORCE",
        "RELEASE"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "problem": {
      "type": "string",
      "minLength": 1
    },
    "options": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "summary"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "selectedOption": {
      "type": "string",
      "minLength": 1
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "programs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "slices": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "domains": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "surfaces": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "authority": {
      "type": "object",
      "required": [
        "decidedBy",
        "managerOnly",
        "humanEscalation"
      ],
      "additionalProperties": false,
      "properties": {
        "decidedBy": {
          "type": "string",
          "minLength": 1
        },
        "managerOnly": {
          "type": "boolean"
        },
        "humanEscalation": {
          "type": "boolean"
        },
        "proposedBy": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^EVD-[0-9]{4,}$"
      }
    },
    "evidenceRefs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "issues": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "prs": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "commits": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          }
        },
        "requests": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^REQ-[0-9]{4,}$"
          }
        }
      }
    },
    "supersedes": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^DEC-[0-9]{4,}$"
    },
    "supersededBy": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^DEC-[0-9]{4,}$"
    },
    "promotion": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "canonical": {
          "type": "boolean"
        },
        "mainPath": {
          "type": [
            "string",
            "null"
          ]
        },
        "mainCommitSha": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{40}$"
        },
        "promotedAt": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?Z$"
        },
        "promotedBy": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "reason": {
      "$ref": "#/$defs/reason"
    }
  },
  "$defs": {
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?Z$"
    },
    "actorRef": {
      "type": "object",
      "required": [
        "type",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "MANAGER",
            "WORKER",
            "HUMAN",
            "SYSTEM"
          ]
        },
        "id": {
          "type": "string",
          "pattern": "^(MANAGER-[0-9]{2}|AGENT-(0[1-9]|10)|HUMAN-[A-Za-z0-9-]+|SYSTEM-[A-Z0-9-]+)$"
        }
      }
    },
    "reason": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "code",
        "summary"
      ],
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "actor": {
          "type": [
            "string",
            "null"
          ]
        },
        "refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "eventRefs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^EVT-[0-9]{6,}$"
      },
      "maxItems": 20
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "domains": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "contracts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "generatedSurfaces": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "vocabulary": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "semanticSurfaces": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "securitySurfaces": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "governanceSurfaces": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
