{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "eventType",
    "objectType",
    "objectId",
    "fromState",
    "toState",
    "actor",
    "revision",
    "timestamp",
    "commandId",
    "reasonCode",
    "evidenceIds",
    "policyDigest"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "pattern": "^EVT-[0-9]{6,}$"
    },
    "eventType": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*$"
    },
    "objectType": {
      "type": "string",
      "minLength": 1
    },
    "objectId": {
      "type": "string",
      "minLength": 1
    },
    "fromState": {
      "type": [
        "string",
        "null"
      ]
    },
    "toState": {
      "type": [
        "string",
        "null"
      ]
    },
    "actor": {
      "$ref": "#/$defs/actorRef"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "timestamp": {
      "$ref": "#/$defs/timestamp"
    },
    "commandId": {
      "type": "string",
      "minLength": 1
    },
    "reasonCode": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidenceIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "policyDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "txId": {
      "type": "string"
    }
  },
  "$defs": {
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?Z$"
    },
    "actorRef": {
      "type": "object",
      "required": [
        "type",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "MANAGER",
            "WORKER",
            "HUMAN",
            "SYSTEM"
          ]
        },
        "id": {
          "type": "string",
          "pattern": "^(MANAGER-[0-9]{2}|AGENT-(0[1-9]|10)|HUMAN-[A-Za-z0-9-]+|SYSTEM-[A-Z0-9-]+)$"
        }
      }
    },
    "reason": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "code",
        "summary"
      ],
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "actor": {
          "type": [
            "string",
            "null"
          ]
        },
        "refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "eventRefs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^EVT-[0-9]{6,}$"
      },
      "maxItems": 20
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "domains": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "contracts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "generatedSurfaces": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "vocabulary": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "semanticSurfaces": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "securitySurfaces": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "governanceSurfaces": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
