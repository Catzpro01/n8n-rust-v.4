{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Catzpro01/n8n-rust-v.4/docs/engineering-operations/workforce/schemas/reservation.schema.json",
  "title": "Reservation",
  "description": "Pre-Git collision boundary. Fingerprint = sha256 of the normalized, sorted scope; equivalent scopes produce equal fingerprints (#264 \u00a74).",
  "type": "object",
  "required": [
    "schemaVersion",
    "objectType",
    "objectId",
    "revision",
    "createdAt",
    "updatedAt",
    "state",
    "taskId",
    "ownerAgentId",
    "scope",
    "mode",
    "fingerprint"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "objectType": {
      "const": "Reservation"
    },
    "objectId": {
      "type": "string",
      "pattern": "^RES-[0-9]{4,}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "createdAt": {
      "$ref": "#/$defs/timestamp"
    },
    "updatedAt": {
      "$ref": "#/$defs/timestamp"
    },
    "events": {
      "$ref": "#/$defs/eventRefs"
    },
    "state": {
      "enum": [
        "REQUESTED",
        "CHECKING",
        "RESERVED",
        "ACTIVE",
        "CONFLICT",
        "RELEASED",
        "REJECTED",
        "EXPIRED",
        "TRANSFERRED"
      ]
    },
    "taskId": {
      "type": "string",
      "pattern": "^TASK-[0-9]{4,}$"
    },
    "ownerAgentId": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^AGENT-(0[1-9]|10)$"
    },
    "scope": {
      "$ref": "#/$defs/scope"
    },
    "mode": {
      "enum": [
        "SHARED_READ",
        "SHARED_WRITE",
        "EXCLUSIVE",
        "CONTRACT_LOCK",
        "GOVERNANCE_LOCK"
      ]
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "reservationId",
          "dimension",
          "compatibility"
        ],
        "additionalProperties": false,
        "properties": {
          "reservationId": {
            "type": "string",
            "pattern": "^RES-[0-9]{4,}$"
          },
          "dimension": {
            "type": "string",
            "minLength": 1
          },
          "compatibility": {
            "enum": [
              "CONFLICT",
              "CONDITIONAL"
            ]
          },
          "overlap": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "parallelism": {
      "enum": [
        "SAFE_PARALLEL",
        "CONDITIONAL_PARALLEL",
        "SERIALIZED",
        "HOLD",
        null
      ]
    },
    "leaseId": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^LEASE-[0-9]{4,}$"
    },
    "predecessorId": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^RES-[0-9]{4,}$"
    },
    "successorId": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^RES-[0-9]{4,}$"
    },
    "expiresAt": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?Z$"
    },
    "releasedAt": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?Z$"
    },
    "reason": {
      "$ref": "#/$defs/reason"
    }
  },
  "$defs": {
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?Z$"
    },
    "actorRef": {
      "type": "object",
      "required": [
        "type",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "MANAGER",
            "WORKER",
            "HUMAN",
            "SYSTEM"
          ]
        },
        "id": {
          "type": "string",
          "pattern": "^(MANAGER-[0-9]{2}|AGENT-(0[1-9]|10)|HUMAN-[A-Za-z0-9-]+|SYSTEM-[A-Z0-9-]+)$"
        }
      }
    },
    "reason": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "code",
        "summary"
      ],
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "actor": {
          "type": [
            "string",
            "null"
          ]
        },
        "refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "eventRefs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^EVT-[0-9]{6,}$"
      },
      "maxItems": 20
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "domains": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "contracts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "generatedSurfaces": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "vocabulary": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "semanticSurfaces": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "securitySurfaces": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "governanceSurfaces": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
