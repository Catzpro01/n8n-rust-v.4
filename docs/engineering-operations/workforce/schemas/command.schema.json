{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Command",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "commandId",
    "commandType",
    "schemaVersion",
    "actor",
    "target",
    "expectedRevision",
    "idempotencyKey",
    "requestedAt",
    "reason",
    "payload"
  ],
  "properties": {
    "commandId": {
      "type": "string",
      "pattern": "^CMD-[A-Za-z0-9._:-]{3,}$"
    },
    "commandType": {
      "enum": [
        "AGENT_ACTIVATE",
        "AGENT_RECONFIGURE",
        "AGENT_HEARTBEAT",
        "AGENT_MARK_LOST",
        "AGENT_RECOVER",
        "AGENT_REGISTER",
        "AGENT_RETIRE",
        "AGENT_STATUS",
        "AGENT_STOP",
        "AGENT_SUSPEND",
        "DECISION_ACTIVATE",
        "DECISION_PROMOTE_CANONICAL",
        "DECISION_PROPOSE",
        "DECISION_REJECT",
        "DECISION_REVIEW",
        "DECISION_REVOKE",
        "DECISION_SUPERSEDE",
        "EVIDENCE_PROPOSE",
        "EVIDENCE_PUBLISH",
        "EVIDENCE_REVOKE",
        "EVIDENCE_VERIFY",
        "HANDOFF_PUBLISH",
        "HUMAN_APPROVE",
        "HUMAN_ESCALATION_RESOLUTION",
        "HUMAN_OVERRIDE",
        "HUMAN_REJECT",
        "JOURNAL_APPEND",
        "LEASE_COMPLETE",
        "LEASE_EXPIRE",
        "LEASE_ISSUE",
        "LEASE_RENEW",
        "LEASE_REVOKE",
        "MQ_ADMIT",
        "MQ_AUTHORIZE",
        "MQ_CLASSIFY",
        "MQ_HOLD",
        "MQ_MERGE_RESULT",
        "MQ_MERGE_START",
        "MQ_OBSERVE_HEAD",
        "MQ_REJECT",
        "MQ_RELEASE",
        "MQ_SUPERSEDE",
        "MQ_UPDATE_CHECKS",
        "MQ_VERIFY",
        "REQUEST_MANAGER_CHANGE",
        "REQUEST_RESOLVE",
        "RESERVATION_ACTIVATE",
        "RESERVATION_CHECK",
        "RESERVATION_EXPIRE",
        "RESERVATION_REJECT",
        "RESERVATION_RELEASE",
        "RESERVATION_REQUEST",
        "RESERVATION_TRANSFER",
        "TASK_ACK",
        "TASK_ADD_DEPENDENCY",
        "TASK_ASSIGN",
        "TASK_BLOCK",
        "TASK_CANCEL",
        "TASK_COMPLETE",
        "TASK_CREATE",
        "TASK_DEFER",
        "TASK_FREEZE",
        "TASK_HOLD",
        "TASK_MERGE_START",
        "TASK_PREPARE",
        "TASK_PROGRESS",
        "TASK_READY_FOR_REVIEW",
        "TASK_RESUME_REVIEW",
        "TASK_REWORK",
        "TASK_START",
        "TASK_SUPERSEDE",
        "TASK_TRANSFER",
        "TASK_UNCLAIM",
        "TASK_UNFREEZE",
        "TASK_VERIFY_START",
        "TASK_WAIT_EXTERNAL"
      ]
    },
    "schemaVersion": {
      "const": "1.0"
    },
    "actor": {
      "$ref": "#/$defs/actorRef"
    },
    "target": {
      "type": "object",
      "required": [
        "objectType",
        "objectId"
      ],
      "additionalProperties": false,
      "properties": {
        "objectType": {
          "enum": [
            "Task",
            "Reservation",
            "AgentState",
            "Lease",
            "Evidence",
            "Decision",
            "MergeQueueItem",
            "Handoff",
            "Request",
            "Approval",
            "JournalEntry"
          ]
        },
        "objectId": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "expectedRevision": {
      "type": "integer",
      "minimum": 0
    },
    "idempotencyKey": {
      "type": "string",
      "minLength": 3,
      "maxLength": 200
    },
    "requestedAt": {
      "$ref": "#/$defs/timestamp"
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "payload": {
      "type": "object"
    }
  },
  "$defs": {
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?Z$"
    },
    "actorRef": {
      "type": "object",
      "required": [
        "type",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "MANAGER",
            "WORKER",
            "HUMAN",
            "SYSTEM"
          ]
        },
        "id": {
          "type": "string",
          "pattern": "^(MANAGER-[0-9]{2}|AGENT-(0[1-9]|10)|HUMAN-[A-Za-z0-9-]+|SYSTEM-[A-Z0-9-]+)$"
        }
      }
    },
    "reason": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "code",
        "summary"
      ],
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "actor": {
          "type": [
            "string",
            "null"
          ]
        },
        "refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "eventRefs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^EVT-[0-9]{6,}$"
      },
      "maxItems": 20
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "domains": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "contracts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "generatedSurfaces": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "vocabulary": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "semanticSurfaces": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "securitySurfaces": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "governanceSurfaces": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
