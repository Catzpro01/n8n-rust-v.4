{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Catzpro01/n8n-rust-v.4/docs/engineering-operations/workforce/schemas/agent-state.schema.json",
  "title": "AgentState",
  "description": "Describes the worker slot, not task ownership: AgentState != TaskState (#263 \u00a76).",
  "type": "object",
  "required": [
    "schemaVersion",
    "objectType",
    "objectId",
    "revision",
    "createdAt",
    "updatedAt",
    "state",
    "slot",
    "identity",
    "capabilities",
    "capacity",
    "heartbeat",
    "health"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "objectType": {
      "const": "AgentState"
    },
    "objectId": {
      "type": "string",
      "pattern": "^AGENT-(0[1-9]|10)$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "createdAt": {
      "$ref": "#/$defs/timestamp"
    },
    "updatedAt": {
      "$ref": "#/$defs/timestamp"
    },
    "events": {
      "$ref": "#/$defs/eventRefs"
    },
    "state": {
      "enum": [
        "AVAILABLE",
        "ASSIGNED",
        "PREPARING",
        "WORKING",
        "WAITING_EXTERNAL",
        "BLOCKED",
        "READY_FOR_REVIEW",
        "MERGING",
        "VERIFYING",
        "STOPPED",
        "SUSPENDED",
        "LOST",
        "RETIRED"
      ]
    },
    "slot": {
      "type": "string",
      "pattern": "^arena/agent-(0[1-9]|10)$"
    },
    "identity": {
      "type": "object",
      "required": [
        "role",
        "enabled",
        "generation"
      ],
      "additionalProperties": false,
      "properties": {
        "role": {
          "const": "WORKER"
        },
        "enabled": {
          "type": "boolean"
        },
        "generation": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "capacity": {
      "type": "object",
      "required": [
        "class",
        "activeTaskCount",
        "maxConcurrentTasks",
        "runnerClass"
      ],
      "additionalProperties": false,
      "properties": {
        "class": {
          "enum": [
            "LIGHT",
            "NORMAL",
            "HEAVY"
          ]
        },
        "activeTaskCount": {
          "type": "integer",
          "minimum": 0
        },
        "maxConcurrentTasks": {
          "type": "integer",
          "minimum": 1
        },
        "runnerClass": {
          "enum": [
            "WINDOWS",
            "WSL",
            "ANY"
          ]
        },
        "cpuClass": {
          "type": "string"
        },
        "memoryClass": {
          "type": "string"
        }
      }
    },
    "assignment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "taskIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^TASK-[0-9]{4,}$"
          }
        },
        "lastAssignedAt": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?Z$"
        },
        "lastReleasedAt": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?Z$"
        }
      }
    },
    "heartbeat": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "lastSeenAt": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?Z$"
        },
        "lastProgressAt": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?Z$"
        },
        "runnerId": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "branch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "persistent": {
          "type": "string"
        },
        "task": {
          "type": [
            "string",
            "null"
          ]
        },
        "headSha": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "health": {
      "type": "object",
      "required": [
        "status",
        "consecutiveFailures"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "HEALTHY",
            "DEGRADED",
            "UNHEALTHY"
          ]
        },
        "consecutiveFailures": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "reason": {
      "$ref": "#/$defs/reason"
    }
  },
  "$defs": {
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?Z$"
    },
    "actorRef": {
      "type": "object",
      "required": [
        "type",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "MANAGER",
            "WORKER",
            "HUMAN",
            "SYSTEM"
          ]
        },
        "id": {
          "type": "string",
          "pattern": "^(MANAGER-[0-9]{2}|AGENT-(0[1-9]|10)|HUMAN-[A-Za-z0-9-]+|SYSTEM-[A-Z0-9-]+)$"
        }
      }
    },
    "reason": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "code",
        "summary"
      ],
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "actor": {
          "type": [
            "string",
            "null"
          ]
        },
        "refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "eventRefs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^EVT-[0-9]{6,}$"
      },
      "maxItems": 20
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "domains": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "contracts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "generatedSurfaces": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "vocabulary": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "semanticSurfaces": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "securitySurfaces": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "governanceSurfaces": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
