{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Catzpro01/n8n-rust-v.4/docs/engineering-operations/workforce/schemas/evidence.schema.json",
  "title": "Evidence",
  "description": "Proof, not status. Anchored to an immutable subject (commit, PR exact head, workflow run, main SHA, artifact digest) (#264 \u00a76).",
  "type": "object",
  "required": [
    "schemaVersion",
    "objectType",
    "objectId",
    "revision",
    "createdAt",
    "updatedAt",
    "state",
    "taskId",
    "type",
    "trustLevel",
    "subject",
    "result",
    "producedBy"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "objectType": {
      "const": "Evidence"
    },
    "objectId": {
      "type": "string",
      "pattern": "^EVD-[0-9]{4,}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "createdAt": {
      "$ref": "#/$defs/timestamp"
    },
    "updatedAt": {
      "$ref": "#/$defs/timestamp"
    },
    "events": {
      "$ref": "#/$defs/eventRefs"
    },
    "state": {
      "enum": [
        "PROPOSED",
        "PUBLISHED",
        "VERIFIED",
        "REVOKED"
      ]
    },
    "taskId": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^TASK-[0-9]{4,}$"
    },
    "sliceId": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^SLICE-[0-9]{4,}$"
    },
    "type": {
      "enum": [
        "CLAIM",
        "COMMIT",
        "TEST",
        "CI",
        "ARCHITECTURE",
        "CONFORMANCE",
        "VISUAL",
        "PERFORMANCE",
        "DEPLOYMENT",
        "REVIEW",
        "NEGATIVE_TEST",
        "MAIN_VERIFICATION"
      ]
    },
    "trustLevel": {
      "enum": [
        "SELF_REPORTED",
        "AUTOMATED",
        "CI_VERIFIED",
        "REVIEW_VERIFIED",
        "MAIN_VERIFIED",
        "PRODUCTION_VERIFIED"
      ]
    },
    "subject": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "subjectType",
        "subjectId"
      ],
      "additionalProperties": false,
      "properties": {
        "subjectType": {
          "enum": [
            "COMMIT",
            "PR_HEAD",
            "WORKFLOW_RUN",
            "MAIN",
            "ARTIFACT"
          ]
        },
        "subjectId": {
          "type": "string",
          "minLength": 1
        },
        "subjectDigest": {
          "type": [
            "string",
            "null"
          ]
        },
        "repository": {
          "type": [
            "string",
            "null"
          ]
        },
        "prNumber": {
          "type": [
            "integer",
            "null"
          ]
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "result": {
      "type": "object",
      "required": [
        "status",
        "summary"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "PASS",
            "FAIL",
            "INFO"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "metrics": {
          "type": "object"
        },
        "failureClass": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "producedBy": {
      "type": "string",
      "minLength": 1
    },
    "verifiedAt": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?Z$"
    },
    "verifiedBy": {
      "type": [
        "string",
        "null"
      ]
    },
    "reason": {
      "$ref": "#/$defs/reason"
    }
  },
  "$defs": {
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?Z$"
    },
    "actorRef": {
      "type": "object",
      "required": [
        "type",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "MANAGER",
            "WORKER",
            "HUMAN",
            "SYSTEM"
          ]
        },
        "id": {
          "type": "string",
          "pattern": "^(MANAGER-[0-9]{2}|AGENT-(0[1-9]|10)|HUMAN-[A-Za-z0-9-]+|SYSTEM-[A-Z0-9-]+)$"
        }
      }
    },
    "reason": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "code",
        "summary"
      ],
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "actor": {
          "type": [
            "string",
            "null"
          ]
        },
        "refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "eventRefs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^EVT-[0-9]{6,}$"
      },
      "maxItems": 20
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "domains": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "contracts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "generatedSurfaces": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "vocabulary": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "semanticSurfaces": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "securitySurfaces": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "governanceSurfaces": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
