{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Catzpro01/n8n-rust-v.4/docs/engineering-operations/workforce/schemas/handoff.schema.json",
  "title": "Handoff",
  "description": "Durable save point for transfer/recovery (#259 \u00a78).",
  "type": "object",
  "required": [
    "schemaVersion",
    "objectType",
    "objectId",
    "revision",
    "createdAt",
    "updatedAt",
    "taskId",
    "author",
    "issue",
    "branch",
    "commitSha",
    "files",
    "tests",
    "evidence",
    "decisions",
    "blockers",
    "nextAction",
    "managerDecisionRequired"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "objectType": {
      "const": "Handoff"
    },
    "objectId": {
      "type": "string",
      "pattern": "^HND-[0-9]{4,}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "createdAt": {
      "$ref": "#/$defs/timestamp"
    },
    "updatedAt": {
      "$ref": "#/$defs/timestamp"
    },
    "events": {
      "$ref": "#/$defs/eventRefs"
    },
    "taskId": {
      "type": "string",
      "pattern": "^TASK-[0-9]{4,}$"
    },
    "author": {
      "type": "string",
      "minLength": 1
    },
    "issue": {
      "type": [
        "integer",
        "null"
      ]
    },
    "slice": {
      "type": [
        "string",
        "null"
      ]
    },
    "branch": {
      "type": "string",
      "minLength": 1
    },
    "commitSha": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{40}$"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^EVD-[0-9]{4,}$"
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^DEC-[0-9]{4,}$"
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "nextAction": {
      "type": "string",
      "minLength": 1
    },
    "managerDecisionRequired": {
      "type": "boolean"
    }
  },
  "$defs": {
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?Z$"
    },
    "actorRef": {
      "type": "object",
      "required": [
        "type",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "MANAGER",
            "WORKER",
            "HUMAN",
            "SYSTEM"
          ]
        },
        "id": {
          "type": "string",
          "pattern": "^(MANAGER-[0-9]{2}|AGENT-(0[1-9]|10)|HUMAN-[A-Za-z0-9-]+|SYSTEM-[A-Z0-9-]+)$"
        }
      }
    },
    "reason": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "code",
        "summary"
      ],
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "actor": {
          "type": [
            "string",
            "null"
          ]
        },
        "refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "eventRefs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^EVT-[0-9]{6,}$"
      },
      "maxItems": 20
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "domains": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "contracts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "generatedSurfaces": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "vocabulary": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "semanticSurfaces": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "securitySurfaces": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "governanceSurfaces": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
