{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Catzpro01/n8n-rust-v.4/docs/engineering-operations/workforce/schemas/merge-queue.schema.json",
  "title": "MergeQueueItem",
  "description": "Deterministic integration surface. Pins repository, PR number, base, exact head SHA, taskId and agentId. A head change forces READY -> HOLD (#264 \u00a77).",
  "type": "object",
  "required": [
    "schemaVersion",
    "objectType",
    "objectId",
    "revision",
    "createdAt",
    "updatedAt",
    "state",
    "pr",
    "taskId",
    "agentId",
    "lane",
    "classification",
    "checks",
    "rollback"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "objectType": {
      "const": "MergeQueueItem"
    },
    "objectId": {
      "type": "string",
      "pattern": "^MQ-[0-9]{4,}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "createdAt": {
      "$ref": "#/$defs/timestamp"
    },
    "updatedAt": {
      "$ref": "#/$defs/timestamp"
    },
    "events": {
      "$ref": "#/$defs/eventRefs"
    },
    "state": {
      "enum": [
        "QUEUED",
        "READY",
        "MERGING",
        "VERIFYING",
        "HOLD",
        "MERGED",
        "REJECTED",
        "SUPERSEDED"
      ]
    },
    "pr": {
      "type": "object",
      "required": [
        "repository",
        "number",
        "base",
        "headSha"
      ],
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "base": {
          "type": "string",
          "minLength": 1
        },
        "headSha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "baseSha": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "taskId": {
      "type": "string",
      "pattern": "^TASK-[0-9]{4,}$"
    },
    "agentId": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^AGENT-(0[1-9]|10)$"
    },
    "lane": {
      "enum": [
        "SAFE-AUTO",
        "MANAGER",
        "HOLD"
      ]
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "governanceChange": {
          "type": "boolean"
        },
        "securityChange": {
          "type": "boolean"
        },
        "contractLock": {
          "type": "boolean"
        },
        "generatedState": {
          "type": "boolean"
        },
        "migration": {
          "type": "boolean"
        },
        "sharedSurface": {
          "type": "boolean"
        },
        "humanApprovalRequired": {
          "type": "boolean"
        },
        "decisionPending": {
          "type": "boolean"
        },
        "impact": {
          "enum": [
            "LOCAL",
            "CONTRACT",
            "CROSS_DOMAIN",
            "GOVERNANCE",
            "SECURITY",
            "GENERATED",
            "MIGRATION",
            "RELEASE"
          ]
        }
      }
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "exactHeadCi": {
          "enum": [
            "PENDING",
            "PASS",
            "FAIL",
            "CLEAR",
            "BLOCKED"
          ]
        },
        "architecture": {
          "enum": [
            "PENDING",
            "PASS",
            "FAIL",
            "CLEAR",
            "BLOCKED"
          ]
        },
        "acceptance": {
          "enum": [
            "PENDING",
            "PASS",
            "FAIL",
            "CLEAR",
            "BLOCKED"
          ]
        },
        "evidence": {
          "enum": [
            "PENDING",
            "PASS",
            "FAIL",
            "CLEAR",
            "BLOCKED"
          ]
        },
        "reservation": {
          "enum": [
            "PENDING",
            "PASS",
            "FAIL",
            "CLEAR",
            "BLOCKED"
          ]
        },
        "dependency": {
          "enum": [
            "PENDING",
            "PASS",
            "FAIL",
            "CLEAR",
            "BLOCKED"
          ]
        },
        "checkedHeadSha": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "rollback": {
      "type": "object",
      "required": [
        "class"
      ],
      "additionalProperties": false,
      "properties": {
        "class": {
          "enum": [
            "SIMPLE",
            "COORDINATED",
            "MIGRATION",
            "IRREVERSIBLE"
          ]
        },
        "strategy": {
          "type": [
            "string",
            "null"
          ]
        },
        "verified": {
          "type": "boolean"
        }
      }
    },
    "authorizationLeaseId": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^LEASE-[0-9]{4,}$"
    },
    "humanApprovalId": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^APR-[0-9]{4,}$"
    },
    "mergeSha": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{40}$"
    },
    "verifiedMainSha": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{40}$"
    },
    "laneReasons": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "reason": {
      "$ref": "#/$defs/reason"
    }
  },
  "$defs": {
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?Z$"
    },
    "actorRef": {
      "type": "object",
      "required": [
        "type",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "MANAGER",
            "WORKER",
            "HUMAN",
            "SYSTEM"
          ]
        },
        "id": {
          "type": "string",
          "pattern": "^(MANAGER-[0-9]{2}|AGENT-(0[1-9]|10)|HUMAN-[A-Za-z0-9-]+|SYSTEM-[A-Z0-9-]+)$"
        }
      }
    },
    "reason": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "code",
        "summary"
      ],
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "actor": {
          "type": [
            "string",
            "null"
          ]
        },
        "refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "eventRefs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^EVT-[0-9]{6,}$"
      },
      "maxItems": 20
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "domains": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "contracts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "generatedSurfaces": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "vocabulary": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "semanticSurfaces": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "securitySurfaces": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "governanceSurfaces": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
