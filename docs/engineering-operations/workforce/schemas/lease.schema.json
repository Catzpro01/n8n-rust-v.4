{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Catzpro01/n8n-rust-v.4/docs/engineering-operations/workforce/schemas/lease.schema.json",
  "title": "Lease",
  "description": "Temporary authority over one subject. Grants neither capability nor permanent permission. Terminal leases are never revived (#265 \u00a714).",
  "type": "object",
  "required": [
    "schemaVersion",
    "objectType",
    "objectId",
    "revision",
    "createdAt",
    "updatedAt",
    "state",
    "leaseType",
    "subject",
    "holder",
    "issuedBy",
    "issuedAt",
    "expiresAt",
    "maxExpiresAt",
    "renewable"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "objectType": {
      "const": "Lease"
    },
    "objectId": {
      "type": "string",
      "pattern": "^LEASE-[0-9]{4,}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "createdAt": {
      "$ref": "#/$defs/timestamp"
    },
    "updatedAt": {
      "$ref": "#/$defs/timestamp"
    },
    "events": {
      "$ref": "#/$defs/eventRefs"
    },
    "state": {
      "enum": [
        "PENDING",
        "ACTIVE",
        "EXPIRED",
        "REVOKED",
        "TRANSFERRED",
        "COMPLETED"
      ]
    },
    "leaseType": {
      "enum": [
        "TASK_ASSIGNMENT",
        "RESERVATION",
        "MERGE_AUTHORIZATION",
        "EXTERNAL_EXECUTION"
      ]
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "taskId": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^TASK-[0-9]{4,}$"
        },
        "reservationId": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^RES-[0-9]{4,}$"
        },
        "queueItemId": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^MQ-[0-9]{4,}$"
        },
        "repository": {
          "type": [
            "string",
            "null"
          ]
        },
        "prNumber": {
          "type": [
            "integer",
            "null"
          ]
        },
        "base": {
          "type": [
            "string",
            "null"
          ]
        },
        "headSha": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "holder": {
      "type": "string",
      "minLength": 1
    },
    "issuedBy": {
      "type": "string",
      "minLength": 1
    },
    "issuedAt": {
      "$ref": "#/$defs/timestamp"
    },
    "renewedAt": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?Z$"
    },
    "expiresAt": {
      "$ref": "#/$defs/timestamp"
    },
    "maxExpiresAt": {
      "$ref": "#/$defs/timestamp"
    },
    "renewable": {
      "type": "boolean"
    },
    "renewCount": {
      "type": "integer",
      "minimum": 0
    },
    "predecessorId": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^LEASE-[0-9]{4,}$"
    },
    "successorId": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^LEASE-[0-9]{4,}$"
    },
    "reason": {
      "$ref": "#/$defs/reason"
    }
  },
  "$defs": {
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?Z$"
    },
    "actorRef": {
      "type": "object",
      "required": [
        "type",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "MANAGER",
            "WORKER",
            "HUMAN",
            "SYSTEM"
          ]
        },
        "id": {
          "type": "string",
          "pattern": "^(MANAGER-[0-9]{2}|AGENT-(0[1-9]|10)|HUMAN-[A-Za-z0-9-]+|SYSTEM-[A-Z0-9-]+)$"
        }
      }
    },
    "reason": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "code",
        "summary"
      ],
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "actor": {
          "type": [
            "string",
            "null"
          ]
        },
        "refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "eventRefs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^EVT-[0-9]{6,}$"
      },
      "maxItems": 20
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "domains": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "contracts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "generatedSurfaces": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "vocabulary": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "semanticSurfaces": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "securitySurfaces": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "governanceSurfaces": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
