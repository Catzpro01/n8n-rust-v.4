{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Catzpro01/n8n-rust-v.4/docs/engineering-operations/workforce/schemas/slice.schema.json",
  "title": "Slice",
  "description": "Delivery unit (DEC-0014). A Slice groups one or more Tasks (execution units) and is delivered by exactly one PR. It completes only through the eight-point gate in policy.slices.completionGate.",
  "type": "object",
  "required": [
    "schemaVersion",
    "objectType",
    "objectId",
    "revision",
    "createdAt",
    "updatedAt",
    "state",
    "key",
    "program",
    "title",
    "acceptance",
    "delivery",
    "rejectedDeliveries",
    "milestoneRegister",
    "completedMainSha"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "objectType": {
      "const": "Slice"
    },
    "objectId": {
      "type": "string",
      "pattern": "^SLICE-[0-9]{4,}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "createdAt": {
      "$ref": "#/$defs/timestamp"
    },
    "updatedAt": {
      "$ref": "#/$defs/timestamp"
    },
    "events": {
      "$ref": "#/$defs/eventRefs"
    },
    "state": {
      "enum": [
        "OPEN",
        "DELIVERING",
        "MERGING",
        "VERIFYING",
        "REGRESSION",
        "COMPLETED",
        "CANCELLED",
        "SUPERSEDED"
      ]
    },
    "key": {
      "type": "string",
      "pattern": "^(P([0-9]|1[01])|FUTURE-[A-Z-]+)-[SM][0-9]{2,}$"
    },
    "program": {
      "type": "string",
      "pattern": "^(P([0-9]|1[01])|FUTURE-[A-Z-]+)$"
    },
    "milestone": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "issue": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "acceptance": {
      "type": "object",
      "required": [
        "criteria"
      ],
      "additionalProperties": false,
      "properties": {
        "criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "text",
              "met"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9._-]{1,64}$"
              },
              "text": {
                "type": "string",
                "minLength": 1
              },
              "met": {
                "type": "boolean"
              },
              "evidenceRef": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      }
    },
    "delivery": {
      "type": "object",
      "required": [
        "prNumber",
        "headSha",
        "mergeQueueItemId",
        "mergeSha",
        "verifiedMainSha"
      ],
      "additionalProperties": false,
      "properties": {
        "prNumber": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "headSha": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{40}$"
        },
        "mergeQueueItemId": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^MQ-[0-9]{4,}$"
        },
        "mergeSha": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{40}$"
        },
        "verifiedMainSha": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "rejectedDeliveries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "prNumber",
          "headSha",
          "mergeQueueItemId"
        ],
        "additionalProperties": false,
        "properties": {
          "prNumber": {
            "type": "integer",
            "minimum": 1
          },
          "headSha": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "mergeQueueItemId": {
            "type": "string",
            "pattern": "^MQ-[0-9]{4,}$"
          },
          "reasonCode": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "milestoneRegister": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "path",
        "commitSha"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "commitSha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "completedMainSha": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{40}$"
    },
    "supersededBy": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^SLICE-[0-9]{4,}$"
    },
    "reason": {
      "$ref": "#/$defs/reason"
    },
    "runnerVerification": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "status",
        "checks",
        "mainSha",
        "evidenceId",
        "regressionTaskIds"
      ],
      "properties": {
        "status": {
          "enum": [
            "NOT_REQUIRED",
            "WAITING_RUNNER",
            "PASS",
            "FAIL"
          ]
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "mainSha": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{40}$"
        },
        "evidenceId": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^EVD-[0-9]{4,}$"
        },
        "regressionTaskIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^TASK-[0-9]{4,}$"
          }
        }
      }
    }
  },
  "$defs": {
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?Z$"
    },
    "eventRefs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^EVT-[0-9]{6,}$"
      },
      "maxItems": 20
    },
    "reason": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "code",
        "summary"
      ],
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "actor": {
          "type": [
            "string",
            "null"
          ]
        },
        "refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
