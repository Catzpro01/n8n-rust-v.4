{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Catzpro01/n8n-rust-v.4/docs/engineering-operations/workforce/schemas/task.schema.json",
  "title": "Task",
  "description": "Scheduler unit. Job is only a grouping (jobId). Dependencies are typed; only REQUIRED blocks completion by default (#264 \u00a710).",
  "type": "object",
  "required": [
    "schemaVersion",
    "objectType",
    "objectId",
    "revision",
    "createdAt",
    "updatedAt",
    "state",
    "title",
    "priority",
    "risk",
    "owner",
    "dependencies",
    "scope",
    "constraints",
    "requirements",
    "acceptance",
    "execution",
    "branch",
    "current",
    "history"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "objectType": {
      "const": "Task"
    },
    "objectId": {
      "type": "string",
      "pattern": "^TASK-[0-9]{4,}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "createdAt": {
      "$ref": "#/$defs/timestamp"
    },
    "updatedAt": {
      "$ref": "#/$defs/timestamp"
    },
    "events": {
      "$ref": "#/$defs/eventRefs"
    },
    "state": {
      "enum": [
        "UNASSIGNED",
        "CLAIMED",
        "ACKNOWLEDGED",
        "PREPARING",
        "WORKING",
        "WAITING_EXTERNAL",
        "BLOCKED",
        "READY_FOR_REVIEW",
        "MERGING",
        "VERIFYING",
        "HOLD",
        "FROZEN",
        "COMPLETED",
        "CANCELLED",
        "SUPERSEDED"
      ]
    },
    "jobId": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^JOB-[0-9]{4,}$"
    },
    "issue": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "program": {
      "type": "string",
      "pattern": "^(P([0-9]|1[01])|FUTURE-[A-Z-]+|GOVERNANCE)$"
    },
    "milestone": {
      "type": [
        "string",
        "null"
      ]
    },
    "slice": {
      "type": [
        "string",
        "null"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "priority": {
      "enum": [
        "CRITICAL",
        "HIGH",
        "NORMAL",
        "LOW"
      ]
    },
    "risk": {
      "enum": [
        "LOW",
        "NORMAL",
        "HIGH",
        "CRITICAL"
      ]
    },
    "owner": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "agentId",
        "assignedAt",
        "assignedBy"
      ],
      "additionalProperties": false,
      "properties": {
        "agentId": {
          "type": "string",
          "pattern": "^AGENT-(0[1-9]|10)$"
        },
        "assignedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "assignedBy": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "taskId",
          "type"
        ],
        "additionalProperties": false,
        "properties": {
          "taskId": {
            "type": "string",
            "pattern": "^TASK-[0-9]{4,}$"
          },
          "type": {
            "enum": [
              "REQUIRED",
              "OPTIONAL",
              "CONDITIONAL",
              "INFORMATIONAL"
            ]
          },
          "condition": {
            "type": [
              "string",
              "null"
            ]
          },
          "conditionMet": {
            "type": [
              "boolean",
              "null"
            ]
          }
        }
      }
    },
    "scope": {
      "$ref": "#/$defs/scope"
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "forbiddenPaths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "forbiddenDomains": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "forbiddenContracts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "securityBoundaries": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "workspaceBoundary": {
          "type": "string"
        }
      }
    },
    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "capacityClass": {
          "enum": [
            "LIGHT",
            "NORMAL",
            "HEAVY"
          ]
        },
        "runnerClasses": {
          "type": "array",
          "items": {
            "enum": [
              "WINDOWS",
              "WSL",
              "ANY"
            ]
          }
        },
        "network": {
          "enum": [
            "NONE",
            "GITHUB",
            "EXTERNAL"
          ]
        }
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "criteria": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "requiredEvidenceTypes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "requiredGates": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mergeLane": {
          "enum": [
            "SAFE-AUTO",
            "MANAGER",
            "HOLD"
          ]
        },
        "rollbackClass": {
          "enum": [
            "SIMPLE",
            "COORDINATED",
            "MIGRATION",
            "IRREVERSIBLE"
          ]
        },
        "activeLeaseId": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^LEASE-[0-9]{4,}$"
        },
        "reservationIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^RES-[0-9]{4,}$"
          }
        },
        "decisionPending": {
          "type": "boolean"
        },
        "hold": {
          "type": "boolean"
        }
      }
    },
    "branch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "persistentBranch": {
          "type": [
            "string",
            "null"
          ]
        },
        "taskBranch": {
          "type": [
            "string",
            "null"
          ]
        },
        "baseSha": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "current": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "headSha": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{40}$"
        },
        "prNumber": {
          "type": [
            "integer",
            "null"
          ]
        },
        "nextAction": {
          "type": [
            "string",
            "null"
          ]
        },
        "blocker": {
          "$ref": "#/$defs/reason"
        },
        "handoffId": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^HND-[0-9]{4,}$"
        },
        "reason": {
          "$ref": "#/$defs/reason"
        },
        "supersededBy": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^TASK-[0-9]{4,}$"
        },
        "completedMainSha": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "history": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reassignedCount": {
          "type": "integer",
          "minimum": 0
        },
        "retryCount": {
          "type": "integer",
          "minimum": 0
        },
        "recoveryCount": {
          "type": "integer",
          "minimum": 0
        },
        "deferCount": {
          "type": "integer",
          "minimum": 0
        },
        "ciRetryCount": {
          "type": "integer",
          "minimum": 0
        },
        "reservationConflictCount": {
          "type": "integer",
          "minimum": 0
        },
        "scopeCorrectionCount": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "$defs": {
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?Z$"
    },
    "actorRef": {
      "type": "object",
      "required": [
        "type",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "MANAGER",
            "WORKER",
            "HUMAN",
            "SYSTEM"
          ]
        },
        "id": {
          "type": "string",
          "pattern": "^(MANAGER-[0-9]{2}|AGENT-(0[1-9]|10)|HUMAN-[A-Za-z0-9-]+|SYSTEM-[A-Z0-9-]+)$"
        }
      }
    },
    "reason": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "code",
        "summary"
      ],
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "actor": {
          "type": [
            "string",
            "null"
          ]
        },
        "refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "eventRefs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^EVT-[0-9]{6,}$"
      },
      "maxItems": 20
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "domains": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "contracts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "generatedSurfaces": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "vocabulary": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "semanticSurfaces": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "securitySurfaces": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "governanceSurfaces": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
