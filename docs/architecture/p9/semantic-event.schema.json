{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:n8n:observability:semantic-event:1.0.0",
  "title": "P9.5 semantic event",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "eventName", "schemaVersion", "envelope", "attributes"],
  "properties": {
    "contractVersion": { "const": "1.0.0" },
    "eventName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "enum": [
        "execution.started",
        "execution.completed",
        "execution.failed",
        "execution.cancelled",
        "checkpoint.created",
        "checkpoint.resumed",
        "trigger.received",
        "trigger.failed",
        "ingress.admitted",
        "ingress.rejected",
        "ingress.deferred",
        "ingress.duplicate",
        "ingress.rate_limited",
        "node.loaded",
        "node.quarantined",
        "node.released",
        "registry.epoch_published",
        "registry.epoch_rolled_back",
        "runtime.lease_acquired",
        "runtime.lease_released"
      ]
    },
    "schemaVersion": { "const": "1.0.0" },
    "sequence": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "envelope": {
      "allOf": [
        { "$ref": "telemetry-envelope.schema.json" },
        {
          "required": ["component"],
          "properties": { "signalType": { "const": "EVENT" } }
        }
      ]
    },
    "attributes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "durationMs": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "attempt": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "itemCount": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "byteCount": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "statusCode": { "type": "integer", "minimum": 100, "maximum": 599 },
        "cacheHit": { "type": "boolean" }
      }
    }
  }
}
