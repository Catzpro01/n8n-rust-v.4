{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:n8n:observability:structured-log:1.0.0",
  "title": "P9.2 structured log",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "envelope",
    "attributes",
    "redactionCount"
  ],
  "properties": {
    "contractVersion": {
      "const": "1.0.0"
    },
    "envelope": {
      "allOf": [
        {
          "$ref": "telemetry-envelope.schema.json"
        },
        {
          "required": [
            "severity",
            "operation",
            "outcome"
          ],
          "properties": {
            "signalType": {
              "const": "LOG"
            }
          }
        }
      ]
    },
    "attributes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "durationMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "attempt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "itemCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "byteCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "statusCode": {
          "type": "integer",
          "minimum": 100,
          "maximum": 599
        },
        "cacheHit": {
          "type": "boolean"
        }
      }
    },
    "redactionCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9
    }
  }
}
