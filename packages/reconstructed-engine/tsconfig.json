{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "noImplicitOverride": true,
    "skipLibCheck": true,
    "types": ["node"],
    "typeRoots": ["../workflow-lego/node_modules/@types", "node_modules/@types"]
  },
  "include": ["src/**/*.ts"]
}
