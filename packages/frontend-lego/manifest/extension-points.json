{
  "catalogVersion": "1.1.0",
  "description": "Insertion points a future frontend feature LEGO may attach to. Declared, not implemented: nothing registers on them in P2.5. The rules in every entry are enforced by the registry — a capability may only name hooks declared here, and may only mutate what it declares.",
  "rules": [
    "Additive by default: a hook appends to a list or wraps a rendering it owns; it never replaces a stock surface.",
    "Declared consumption: a capability must name every hook it uses in its registration, and every surface it renders into.",
    "Deterministic order: declaration order first, then a stable id — two LEGOs cannot fight for one slot.",
    "Own subtree only: an extension may mutate the DOM/state it created, never another extension's subtree and never the pinned bundle.",
    "No backend implementation imports: a hook consumer talks to the compatibility layer through the frontend contract only.",
    "Failure isolation: if a hook consumer throws, the surface it attached to keeps rendering (the frontend LEGO renders the stock behavior)."
  ],
  "extensionPoints": [
    {
      "id": "ui:nav:item",
      "title": "Navigation entry",
      "surface": "navigation",
      "additive": "append",
      "mutates": "own-subtree",
      "requiresCapability": [
        "navigation"
      ],
      "payload": {
        "id": "string (kebab-case, unique)",
        "route": "string (application route, must start with '/')",
        "labelKey": "message key (<slot>.<name>) or, transitionally, a literal label",
        "icon": "string (optional, reference UI icon name)",
        "order": "number (optional)",
        "scope": "string (optional, n8n global scope guarding visibility)"
      },
      "consumers": [
        "search",
        "translation",
        "feature-legos"
      ],
      "status": "declared"
    },
    {
      "id": "ui:settings:section",
      "title": "Settings page / sidebar section",
      "surface": "settings",
      "additive": "append",
      "mutates": "own-subtree",
      "requiresCapability": [
        "settings"
      ],
      "payload": {
        "id": "string (kebab-case, unique)",
        "route": "string (must start with '/settings')",
        "titleKey": "message key (<slot>.<name>)",
        "scope": "string (optional, required global scope)",
        "order": "number (optional)"
      },
      "consumers": [
        "translation",
        "feature-legos"
      ],
      "status": "declared"
    },
    {
      "id": "ui:form:field",
      "title": "Dynamic form field (parameter forms, credentials, settings forms)",
      "surface": "settings",
      "additive": "append",
      "mutates": "own-subtree",
      "requiresCapability": [
        "settings"
      ],
      "payload": {
        "id": "string (kebab-case, unique)",
        "field": "string (parameter/field name it annotates)",
        "decorate": "function(field) -> void (additive decoration only)"
      },
      "consumers": [
        "accessibility",
        "translation",
        "dynamic-form"
      ],
      "status": "declared"
    },
    {
      "id": "ui:node:menu-item",
      "title": "Canvas / node context action",
      "surface": "workflow-editor",
      "additive": "append",
      "mutates": "own-subtree",
      "requiresCapability": [
        "workflow-editor"
      ],
      "payload": {
        "id": "string (kebab-case, unique)",
        "labelKey": "message key (<slot>.<name>)",
        "appliesTo": "string ('node' | 'selection' | 'canvas' | a node type name)",
        "run": "function(context) -> void | Promise<void> (must not mutate foreign state)"
      },
      "consumers": [
        "ai-assistant",
        "node-legos"
      ],
      "status": "declared"
    },
    {
      "id": "ui:dialog:render",
      "title": "Dialog / overlay renderer",
      "surface": "dialogs",
      "additive": "append",
      "mutates": "own-subtree",
      "requiresCapability": [
        "dialogs"
      ],
      "payload": {
        "id": "string (kebab-case, unique)",
        "dialog": "string (dialog kind it handles)",
        "render": "function(ctx) -> void (owns the subtree it mounts)"
      },
      "consumers": [
        "feature-legos"
      ],
      "status": "declared"
    },
    {
      "id": "ui:notification:render",
      "title": "Notification presentation",
      "surface": "notifications",
      "additive": "wrap",
      "mutates": "own-subtree",
      "requiresCapability": [
        "notifications"
      ],
      "payload": {
        "id": "string (kebab-case, unique)",
        "kind": "string ('info' | 'success' | 'warning' | 'error' | push event name)",
        "render": "function(notification, next) -> void (may wrap the default rendering via next)"
      },
      "consumers": [
        "notification",
        "translation",
        "accessibility"
      ],
      "status": "declared"
    },
    {
      "id": "ui:error:render",
      "title": "Error presentation",
      "surface": "error-surfaces",
      "additive": "wrap",
      "mutates": "own-subtree",
      "requiresCapability": [
        "error-surfaces"
      ],
      "payload": {
        "id": "string (kebab-case, unique)",
        "kinds": "string[] (FrontendError kinds this handler covers, e.g. ['unsupported','validation'])",
        "render": "function(frontendError, next) -> void (may wrap the default rendering via next)"
      },
      "consumers": [
        "translation",
        "accessibility",
        "notification"
      ],
      "status": "declared"
    },
    {
      "id": "ui:message:catalog",
      "title": "Message catalog contribution (translation dictionaries)",
      "surface": "error-surfaces",
      "additive": "append",
      "mutates": "none",
      "requiresCapability": [
        "error-surfaces"
      ],
      "payload": {
        "namespace": "string (the registering capability's message namespace)",
        "catalog": "createMessageCatalog({ locale, namespace, entries }) — every key must be <slot>.<name> with a slot from MESSAGE_SLOTS"
      },
      "consumers": [
        "translation"
      ],
      "status": "declared"
    },
    {
      "id": "ui:locale:switch",
      "title": "Locale and direction observation",
      "surface": "navigation",
      "additive": "read",
      "mutates": "none",
      "requiresCapability": [
        "navigation"
      ],
      "payload": {
        "locale": "string (supported locale code; resolveLocale normalizes BCP-47 tags)",
        "direction": "'ltr' | 'rtl' (ar is rtl — direction metadata comes from the locale model, never from the component)"
      },
      "consumers": [
        "translation",
        "accessibility"
      ],
      "status": "declared"
    },
    {
      "id": "ui:theme:tokens",
      "title": "Theme token override",
      "surface": "navigation",
      "additive": "override-named",
      "mutates": "own-subtree",
      "requiresCapability": [
        "navigation"
      ],
      "payload": {
        "tokens": "Record<string, string> (named design tokens only; no selector-level patching of the stock bundle)"
      },
      "consumers": [
        "theme"
      ],
      "status": "declared"
    },
    {
      "id": "ui:command:register",
      "title": "Command / search entry",
      "surface": "navigation",
      "additive": "append",
      "mutates": "none",
      "requiresCapability": [
        "navigation"
      ],
      "payload": {
        "id": "string (kebab-case, unique)",
        "titleKey": "message key (<slot>.<name>)",
        "keywords": "string[] (optional)",
        "run": "function(context) -> void | Promise<void>"
      },
      "consumers": [
        "search"
      ],
      "status": "declared"
    },
    {
      "id": "ui:assistant:panel",
      "title": "Assistant panel mount",
      "surface": "workflow-editor",
      "additive": "append",
      "mutates": "own-subtree",
      "requiresCapability": [
        "workflow-editor"
      ],
      "payload": {
        "id": "string (kebab-case, unique)",
        "mount": "function(container, context) -> void (receives its own container element)",
        "context": "object (read-only view of the workflow/selection)"
      },
      "consumers": [
        "ai-assistant"
      ],
      "status": "declared"
    },
    {
      "id": "ui:search:provider",
      "title": "Search result provider",
      "surface": "navigation",
      "additive": "append",
      "mutates": "none",
      "requiresCapability": [
        "navigation"
      ],
      "payload": {
        "id": "string (kebab-case, unique)",
        "titleKey": "message key (<slot>.<name>)",
        "kind": "string (workflow | node | command | credential | …)",
        "query": "function(query, context) -> Promise<SearchResult[]>",
        "rank": "number (optional — results merge by rank, then id)"
      },
      "consumers": [
        "search"
      ],
      "status": "declared"
    },
    {
      "id": "ui:accessibility:annotate",
      "title": "Accessibility annotation",
      "surface": "error-surfaces",
      "additive": "wrap",
      "mutates": "attributes-only",
      "requiresCapability": [
        "error-surfaces"
      ],
      "payload": {
        "surface": "declared surface id",
        "selector": "string (element inside that surface's own subtree)",
        "attributes": "Record<string, string> (aria-* / role / tabindex only)",
        "labelKey": "message key (<slot>.<name>) for accessible names"
      },
      "consumers": [
        "accessibility"
      ],
      "status": "declared",
      "attributeWhitelist": [
        "aria-*",
        "role",
        "tabindex",
        "lang",
        "dir"
      ],
      "never": [
        "text content",
        "styles or layout",
        "removing or reordering nodes",
        "another extension or surface subtree"
      ]
    },
    {
      "id": "ui:document:format",
      "title": "Document format handler (import / export)",
      "surface": "workflow-editor",
      "additive": "append",
      "mutates": "none",
      "requiresCapability": [
        "workflow-editor"
      ],
      "payload": {
        "id": "string (kebab-case, unique)",
        "titleKey": "message key (<slot>.<name>)",
        "mime": "string (e.g. application/json)",
        "direction": "import | export | both",
        "parse": "function(text, context) -> Promise<Document> (import only)",
        "serialize": "function(document, context) -> Promise<string> (export only)"
      },
      "consumers": [
        "import-export"
      ],
      "status": "declared"
    }
  ],
  "futureConsumers": [
    {
      "id": "translation",
      "title": "Translation LEGO",
      "hooks": [
        "ui:message:catalog",
        "ui:locale:switch",
        "ui:error:render",
        "ui:nav:item",
        "ui:settings:section",
        "ui:notification:render"
      ],
      "status": "not-implemented"
    },
    {
      "id": "accessibility",
      "title": "Accessibility LEGO",
      "hooks": [
        "ui:accessibility:annotate",
        "ui:error:render",
        "ui:notification:render",
        "ui:form:field"
      ],
      "status": "not-implemented"
    },
    {
      "id": "theme",
      "title": "Theme LEGO",
      "hooks": [
        "ui:theme:tokens"
      ],
      "status": "not-implemented"
    },
    {
      "id": "search",
      "title": "Search LEGO",
      "hooks": [
        "ui:search:provider",
        "ui:command:register",
        "ui:nav:item"
      ],
      "status": "not-implemented"
    },
    {
      "id": "ai-assistant",
      "title": "AI Assistant LEGO",
      "hooks": [
        "ui:assistant:panel",
        "ui:node:menu-item"
      ],
      "status": "not-implemented"
    },
    {
      "id": "notification",
      "title": "Notification LEGO",
      "hooks": [
        "ui:notification:render",
        "ui:error:render"
      ],
      "status": "not-implemented"
    },
    {
      "id": "import-export",
      "title": "Import / Export LEGO",
      "hooks": [
        "ui:document:format",
        "ui:dialog:render",
        "ui:notification:render"
      ],
      "status": "not-implemented"
    }
  ]
}
