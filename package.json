{
	"name": "n8n-rust-v4",
	"version": "0.4.0",
	"private": true,
	"description": "n8n 2.9.4 anatomy → contract → reference runtime → LEGO isolation → (later) Rust replacement",
	"scripts": {
		"isolation:check": "node tools/workflow-boundary-map.mjs --check && node tools/workflow-kernel-conformance.mjs --check && node tools/workflow-port-surface.mjs --check && node tools/workflow-reference-manifest.mjs --check",
		"isolation:extract": "node tools/workflow-isolation-extract.mjs",
		"isolation:map": "node tools/workflow-boundary-map.mjs --json packages/workflow-lego/manifest/boundary-map.json --md docs/isolation/workflow-dependency-map.md",
		"localization:all": "npm run localization:test && npm run localization:gate",
		"localization:api": "node tools/localization-inspect.mjs --api-error",
		"localization:envelope": "node tools/localization-inspect.mjs --envelope",
		"localization:gate": "node tools/localization-gate.mjs",
		"localization:hub-diff": "node tools/localization-hub-diff.mjs",
		"localization:inspect": "node tools/localization-inspect.mjs",
		"localization:record": "node tools/localization-inspect.mjs --record",
		"localization:test": "node --test packages/workflow-lego/test/06-localization-runtime.test.ts packages/workflow-lego/test/07-localization-envelope.test.ts packages/workflow-lego/test/08-localization-run-path.test.ts",
		"rust:check-offline": "bash tools/rust-offline-rig/run.sh check",
		"rust:test-offline": "bash tools/rust-offline-rig/run.sh test",
		"setup:reference": "bash scripts/setup-reference-runtime.sh",
		"verify": "node tools/workflow-isolation-gate.mjs",
		"verify:fast": "node tools/workflow-isolation-gate.mjs --skip-live",
		"verify:reconstructed": "node packages/reconstructed-engine/test-run.mjs && node packages/reconstructed-engine/test-enhanced.mjs",
		"workflow-lego:build": "npm --prefix packages/workflow-lego run build",
		"workflow-lego:test": "bash scripts/run-lego-tests.sh"
	}
}
