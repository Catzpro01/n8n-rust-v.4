{
  "name": "n8n-rust-v4",
  "version": "0.4.0",
  "private": true,
  "description": "n8n 2.9.4 anatomy → contract → reference runtime → LEGO isolation → (later) Rust replacement",
  "scripts": {
    "setup:reference": "bash scripts/setup-reference-runtime.sh",
    "verify": "node tools/workflow-isolation-gate.mjs",
    "verify:fast": "node tools/workflow-isolation-gate.mjs --skip-live",
    "isolation:map": "node tools/workflow-boundary-map.mjs --json packages/workflow-lego/manifest/boundary-map.json --md docs/isolation/workflow-dependency-map.md",
    "isolation:check": "node tools/workflow-boundary-map.mjs --check && node tools/workflow-kernel-conformance.mjs --check && node tools/workflow-port-surface.mjs --check && node tools/workflow-reference-manifest.mjs --check",
    "isolation:extract": "node tools/workflow-isolation-extract.mjs",
    "workflow-lego:build": "npm --prefix packages/workflow-lego run build",
    "workflow-lego:test": "bash scripts/run-lego-tests.sh",
    "ts:install": "bash scripts/install.sh",
    "ts:start": "bash scripts/start.sh",
    "ts:stop": "bash scripts/stop.sh",
    "ts:doctor": "bash scripts/doctor.sh",
    "ts:server": "node apps/n8n-ts/src/server.mjs",
    "test:runtime": "node --test tests/runtime/*.test.mjs tests/integration/ts-baseline/*.test.mjs",
    "test:ts-baseline": "node --test tests/runtime/*.test.mjs tests/integration/ts-baseline/*.test.mjs"
  }
}
