# dependencies
node_modules/
target/

# environment
.env
.env.*
!.env.example

# generated / local-only artifacts

# isolated unit produced by tools/workflow-isolation-extract.mjs (reproducible)
packages/workflow-lego/.extract/

# verification runtime (scripts/setup-reference-runtime.sh)
.runtime/

