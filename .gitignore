# dependencies
node_modules/
target/

# environment
.env
.env.*
!.env.example

# generated / local-only artifacts

# isolated unit produced by tools/workflow-isolation-extract.mjs (reproducible)
packages/workflow-lego/.extract/

# verification runtime (scripts/setup-reference-runtime.sh)
.runtime/

# TypeScript baseline runtime (Worker 1 output + Worker 2 local state)
apps/n8n-ts/dist/
apps/n8n-ts/*.tsbuildinfo
.runtime-ts/

# misc
*.log
.DS_Store

# agent-2: n8n reference build noise (local sandbox builds; reference/ itself is tracked per main convention)
reference/**/dist/
reference/**/.turbo/
reference/**/coverage/
__pycache__/

# arena orchestration runtime
.arena/run/
.arena/worker_logs/
.arena/dispatch/
.arena/results/
.arena/processed/
