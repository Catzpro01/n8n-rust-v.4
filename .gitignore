# dependencies
node_modules/
target/

# environment
.env
.env.*
!.env.example

# generated / local-only artifacts

# isolated unit produced by tools/workflow-isolation-extract.mjs (reproducible)
packages/workflow-lego/.extract/

# verification runtime (scripts/setup-reference-runtime.sh)
.runtime/

# TypeScript baseline runtime (Worker 1 output + Worker 2 local state)
apps/n8n-ts/dist/
apps/n8n-ts/*.tsbuildinfo
.runtime-ts/

# misc
*.log
.DS_Store

# agent-2: n8n reference build noise (local sandbox builds; reference/ itself is tracked per main convention)
reference/**/dist/
reference/**/.turbo/
reference/**/coverage/
__pycache__/

# arena orchestration runtime
.arena/run/
.arena/worker_logs/
.arena/dispatch/
.arena/results/
.arena/processed/

# typescript runtime (apps/n8n-ts) generated state
data/
logs/
state/
# ...except the app's bundled data: roles.json is a required runtime artifact for
# npm/Docker/tarball installs (no reference/ checkout there), regenerated
# deterministically from reference/n8n by apps/n8n-lego/scripts/fetch-n8n-roles.mjs.
!apps/n8n-lego/data/
# ...and inside it only the bundled catalog roles file is tracked.
apps/n8n-lego/data/*
!apps/n8n-lego/data/roles.json
# P5.7: the API-key scope vocabulary, extracted by the same script from @n8n/permissions.
!apps/n8n-lego/data/api-key-scopes.json
apps/n8n-ts/.tsbuildinfo

# release artifacts (scripts/release.sh)
dist/
