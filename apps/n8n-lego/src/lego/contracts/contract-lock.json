{
  "lockVersion": "1.1.0",
  "owner": "manager",
  "description": "Contract versioning lock. One row per PUBLIC contract: what it is, who owns it, which version is published, what its consumers are, and where its contract tests live. The architecture gate fails when a published contract's surface changes without its version changing. Intentionally tiny: this is not semver-as-a-framework, it is a change alarm.",
  "policy": {
    "scheme": "major.minor.patch",
    "breaking": [
      "removing or renaming an export",
      "removing or renaming an error code, or changing an existing code's HTTP status",
      "changing the meaning or required shape of a request/response field",
      "narrowing accepted input or widening required output",
      "moving a file out of the declared public surface"
    ],
    "minor": [
      "adding an export",
      "adding an optional field",
      "adding a new error code",
      "adding a capability"
    ],
    "patch": [
      "documentation",
      "internal implementation changes with no surface change"
    ],
    "rule": "A BREAKING change requires: major bump here, a note in docs/n8n-lego/BACKEND_LEGO.md \u00a7Contract changelog, and sign-off from every consumer listed below.",
    "preRelease": "Contracts at 0.x are provisional: they may break with a minor bump, but the bump is still mandatory.",
    "compatibilityModel": {
      "module": "src/lego/compat.mjs",
      "kinds": [
        "unchanged",
        "compatible",
        "migration-required",
        "breaking",
        "downgrade"
      ],
      "ranges": [
        "1.2.3 exact",
        "^1.2.3 same major (0.x: same minor)",
        "~1.2.3 same major.minor",
        ">=1.2.3",
        "*"
      ],
      "note": "0.x contracts are provisional: ^0.2.1 does NOT accept 0.3.0, because a 0.x minor is allowed to break. Consumers of a 0.x contract must be told about every minor."
    },
    "parentChildRule": "A parent contract does NOT version-bump because a sub-LEGO changed compatibly. It bumps only when its own parent-facing surface moves. Example held by the fixtures: reference.validation 1.0.0 -> 1.1.0 (additive) leaves reference.lego at 1.0.0 and reference.repository at 1.0.0. A BREAKING child change that surfaces through the parent does force a parent major bump.",
    "migrations": "A contract may declare `migrations: [\"1.3.0\"]` \u2014 versions that need a data/state migration even though they are semver-compatible. Migration points are declared, never inferred."
  },
  "contracts": [
    {
      "id": "compat.http",
      "owner": "agent-1",
      "domain": "compatibility",
      "version": "1.0.0",
      "status": "stable",
      "surface": [
        "src/compat/route.mjs",
        "src/compat/response.mjs",
        "src/compat/error.mjs",
        "src/compat/auth-context.mjs",
        "src/compat/scopes.mjs",
        "src/compat/capability.mjs"
      ],
      "exports": {
        "src/compat/route.mjs": [
          "createRouter"
        ],
        "src/compat/response.mjs": [
          "sendJson",
          "sendData",
          "sendBare",
          "sendError",
          "readBody"
        ],
        "src/compat/error.mjs": [
          "HttpError",
          "unauthorized",
          "forbidden",
          "notFound",
          "badRequest",
          "unsupported"
        ],
        "src/compat/auth-context.mjs": [
          "publicUser",
          "requireUser"
        ],
        "src/compat/scopes.mjs": [
          "loadRoles",
          "resetRolesCache",
          "getGlobalScopes"
        ],
        "src/compat/capability.mjs": [
          "UNSUPPORTED_FEATURES",
          "resolveUnsupportedFeature",
          "unsupportedFeature",
          "createUnsupportedHandler"
        ]
      },
      "consumers": [
        "auth",
        "settings",
        "legacy-rest",
        "runtime-host",
        "agent-1/frontend"
      ],
      "tests": [
        "apps/n8n-lego/test/compat.contract.test.mjs"
      ]
    },
    {
